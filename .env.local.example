# NightKind Shopify Configuration
# Copy this file to .env and fill in your actual values

# Your Shopify store domain (format: your-store-name.myshopify.com)
REACT_APP_SHOPIFY_STORE_DOMAIN=nightkind-collective.myshopify.com

# Your Shopify Storefront API access token
# Get this from: Shopify Admin → Apps → Your App → API credentials
REACT_APP_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# Shopify API version (use latest stable version)
REACT_APP_SHOPIFY_API_VERSION=2024-01

# IMPORTANT NOTES:
# 1. DO NOT commit this file with real credentials to Git
# 2. All React environment variables must start with REACT_APP_
# 3. Restart your dev server after changing environment variables
# 4. For production, set these in your hosting platform's environment settings
