# Shopify Configuration
# Get these from your Shopify Admin:
# Admin > Apps > Develop apps > Create an app > Configure Storefront API
REACT_APP_SHOPIFY_STORE_DOMAIN=nightkind-collective.myshopify.com
REACT_APP_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here
REACT_APP_SHOPIFY_API_VERSION=2024-01

# Optional: For admin API access (if needed for backend operations)
# SHOPIFY_ADMIN_API_KEY=your_admin_api_key
# SHOPIFY_ADMIN_API_SECRET=your_admin_api_secret
